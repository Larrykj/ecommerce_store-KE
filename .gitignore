# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/
/tmp/

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

# Ignore kamal secrets
/.kamal/secrets
# Ignore key files for decrypting credentials and more.
/config/credentials/*.key

# Ignore IDEs and OS files
/.vscode/
/.idea/
**/.idea/
.DS_Store

# Ignore yarn and node
/node_modules
/vendor
yarn-error.log
yarn-debug.log*
.yarn-integrity

# Ignore sqlite databases
*.sqlite3
*.sqlite3-*

# Ignore coverage
/coverage/

# Ignore test output and runtime artifacts
test_output.txt
test_output.log
test_run*.txt
_locale_fix.txt

# Ignore security scan output
brakeman.json

# Ignore dev/CI scripts and build logs
run_qa.ps1
build_log.txt
build_output*.txt

# Ignore SQLite cache
/db/cache/

# EOF
