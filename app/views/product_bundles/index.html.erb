<% content_for :title, "Product Bundles" %>
<div class="container py-5">
  <h1 class="mb-4">Product Bundles</h1>
  <p class="text-muted mb-4">Save more when you buy together! Browse our curated bundles below.</p>

  <% if @bundles.any? %>
    <div class="row">
      <% @bundles.each do |bundle| %>
        <div class="col-md-4 mb-4">
          <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
              <h5 class="card-title"><%= bundle.name %></h5>
              <% if bundle.description.present? %>
                <p class="card-text text-muted"><%= truncate(bundle.description, length: 120) %></p>
              <% end %>

              <div class="mt-auto">
                <div class="mb-3">
                  <span class="h4 text-primary">KSh <%= number_with_precision(bundle.price, precision: 2) %></span>
                  <% if bundle.computed_original_price > bundle.price %>
                    <br>
                    <small class="text-muted"><s>KSh <%= number_with_precision(bundle.computed_original_price, precision: 2) %></s></small>
                    <span class="badge bg-success ms-1">Save KSh <%= number_with_precision(bundle.savings, precision: 2) %></span>
                  <% end %>
                </div>

                <p class="text-muted small mb-2">
                  <i class="bi bi-box"></i> <%= bundle.items.sum(:quantity) %> item<%= bundle.items.sum(:quantity) == 1 ? '' : 's' %> across <%= bundle.products.count %> product<%= bundle.products.count == 1 ? '' : 's' %>
                </p>

                <%= link_to "View Bundle", product_bundle_path(bundle), class: "btn btn-outline-primary w-100" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <% if @pagy && @pagy.pages > 1 %>
      <div class="mt-4">
        <%== pagy_nav(@pagy) %>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-5">
      <h4 class="text-muted">No bundles available right now</h4>
      <p class="text-muted">Check back soon for great bundle deals!</p>
      <%= link_to "Browse Products", products_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
