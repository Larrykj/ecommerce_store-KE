<% content_for :title, @bundle.name %>
<div class="container py-5">
  <div class="row">
    <div class="col-md-8">
      <h1><%= @bundle.name %></h1>
      
      <div class="mb-4">
        <div class="display-6 text-primary">KSh <%= number_with_precision(@bundle.price, precision: 2) %></div>
        <% if @bundle.original_price %>
          <div>
            <small class="text-muted"><s>KSh <%= number_with_precision(@bundle.original_price, precision: 2) %></s></small>
            <span class="badge bg-success">Save KSh <%= number_with_precision(@bundle.savings, precision: 2) %></span>
          </div>
        <% end %>
      </div>

      <% if @bundle.description %>
        <div class="mb-4">
          <h5>About This Bundle</h5>
          <p><%= @bundle.description %></p>
        </div>
      <% end %>

      <h5>Products Included (<%= @bundle.products.count %>)</h5>
      <div class="row mb-4">
        <% @bundle.products.each do |product| %>
          <div class="col-md-6 mb-3">
            <div class="card">
              <% if product.image.attached? %>
                <%= image_tag product.image, class: 'card-img-top', style: 'max-height: 200px; object-fit: cover;' %>
              <% end %>
              <div class="card-body">
                <h6 class="card-title"><%= product.name %></h6>
                <p class="card-text text-muted">KSh <%= number_with_precision(product.price, precision: 2) %></p>
                <%= link_to 'View Product', product_path(product), class: 'btn btn-sm btn-outline-primary' %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if user_signed_in? %>
        <%= button_to 'Add Bundle to Cart', cart_items_path(bundle_id: @bundle.id), method: :post, class: 'btn btn-primary btn-lg' %>
      <% else %>
        <p class="alert alert-info">
          <%= link_to 'Login', new_user_session_path %> to purchase this bundle.
        </p>
      <% end %>
    </div>

    <div class="col-md-4">
      <div class="card">
        <div class="card-body">
          <h6 class="card-title">Bundle Summary</h6>
          <hr>
          <div class="mb-2 d-flex justify-content-between">
            <span>Subtotal:</span>
            <span>KSh <%= number_with_precision(@bundle.products.sum(&:price), precision: 2) %></span>
          </div>
          <% if @bundle.original_price %>
            <div class="mb-2 d-flex justify-content-between text-success">
              <span>Savings:</span>
              <strong>-KSh <%= number_with_precision(@bundle.savings, precision: 2) %></strong>
            </div>
          <% end %>
          <hr>
          <div class="d-flex justify-content-between">
            <strong>Total:</strong>
            <strong class="text-primary">KSh <%= number_with_precision(@bundle.price, precision: 2) %></strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
