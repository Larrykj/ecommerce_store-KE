<div class="product-card h-100">
  <div class="product-image-wrap">
    <% if product.image.attached? %>
      <%= image_tag product.image, class: "product-image", alt: product.name %>
    <% else %>
      <div class="product-placeholder">
        <i class="bi bi-box-seam"></i>
      </div>
    <% end %>
    <span class="stock-badge badge-<%= product.stock_status_class %>">
      <%= product.stock_status_label %>
    </span>
    <div class="product-overlay">
      <%= link_to product_path(product), class: "overlay-btn", title: t("view_details") do %>
        <i class="bi bi-eye"></i>
      <% end %>
      
      <% if current_user %>
        <%= render partial: "shared/wishlist_button", locals: { product: product, wishlisted: @wishlist_product_ids&.include?(product.id) } %>
      <% end %>
    </div>
  </div>
  <div class="product-info">
    <% if product.category %>
      <span class="product-category"><%= t("categories_data.#{product.category.name.parameterize.underscore}", default: product.category.name) %></span>
    <% end %>
    <h3 class="product-name"><%= link_to product.name, product_path(product) %></h3>
    <% if product.reviews_count > 0 %>
      <div class="product-rating" style="display:flex;align-items:center;gap:6px;margin-bottom:6px;">
        <div class="stars" style="display:flex;gap:1px;">
          <% 5.times do |i| %>
            <i class="bi bi-star<%= i < product.average_rating.round ? '-fill' : '' %>" style="font-size:0.8rem;color:#fbbf24;"></i>
          <% end %>
        </div>
        <span style="font-size:0.75rem;color:#94a3b8;"><%= product.average_rating %> (<%= product.reviews_count %>)</span>
      </div>
    <% end %>
    <p class="product-desc"><%= truncate(t("product_descriptions.#{product.name.parameterize.underscore}", default: product.description), length: 80) %></p>
    <div class="product-footer">
      <div class="product-price">
        <span class="amount"><%= format_price(product.price.to_i) %></span>
      </div>
      <% first_variant = defined?(@first_available_variant) ? @first_available_variant[product.id] : nil %>
      <% if first_variant %>
        <%= button_to cart_items_path(variant_id: first_variant.id), method: :post, class: "add-cart-btn", title: t("add_to_cart") do %>
          <i class="bi bi-cart-plus"></i>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
