<% content_for :title, @category.name %>
<div class="container py-5">
  <h1 class="mb-4"><%= @category.name %></h1>
  <p class="text-muted"><%= @category.description %></p>
  
  <% @posts.each do |post| %>
    <article class="card mb-4">
      <% if post.featured_image %>
        <%= image_tag post.featured_image, class: 'card-img-top', style: 'max-height: 300px; object-fit: cover;' %>
      <% end %>
      <div class="card-body">
        <h2 class="card-title"><%= link_to post.title, blog_post_path(post) %></h2>
        <p class="text-muted">
          <%= post.published_at.strftime('%B %d, %Y') %>
        </p>
        <p class="card-text"><%= post.excerpt_text %></p>
        <%= link_to 'Read More', blog_post_path(post), class: 'btn btn-outline-primary' %>
      </div>
    </article>
  <% end %>
  
  <% if @pagy.pages > 1 %>
    <div class="mt-4">
      <%== @pagy.series_nav(:bootstrap) %>
    </div>
  <% end %>
</div>