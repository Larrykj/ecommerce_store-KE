<!DOCTYPE html>
<html data-theme="light" data-bs-theme="light">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : t('app_name', default: 'E-Commerce Store') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : 'E-Commerce Store - Quality products, secure payments, and fast delivery.' %>">
    <meta property="og:title" content="<%= content_for?(:title) ? yield(:title) : t('app_name', default: 'E-Commerce Store') %>">
    <meta property="og:description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : 'E-Commerce Store - Quality products, secure payments, and fast delivery.' %>">
    <meta property="og:type" content="website">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" defer></script>



  </head>



  <body>

    <!-- Navigation Bar -->

<nav class="navbar navbar-expand-lg mb-4">

  <div class="container">

    <%= link_to t("app_name"), root_path, class: "navbar-brand" %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">

      <span class="navbar-toggler-icon"></span>

    </button>

    <div class="collapse navbar-collapse" id="navbarNav">

      <ul class="navbar-nav ms-auto">

        <li class="nav-item">

          <%= link_to t("products"), products_path, class: "nav-link" %>

        </li>

        <li class="nav-item">

          <%= link_to t("categories"), categories_path, class: "nav-link" %>

        </li>

        <li class="nav-item">

          <%= link_to "Blog", blog_posts_path, class: "nav-link" %>

        </li>

        <li class="nav-item">

          <%= link_to "Bundles", product_bundles_path, class: "nav-link" %>

        </li>

        <li class="nav-item">

          <%= link_to "Flash Sales", flash_sales_path, class: "nav-link" %>

        </li>

        <% if user_signed_in? %>
        <li class="nav-item">

          <%= link_to "Rewards", loyalty_path, class: "nav-link" %>

        </li>
        <% end %>

        

        <!-- Language Switcher -->

        <li class="nav-item dropdown">

          <a class="nav-link dropdown-toggle" href="#" id="languageDropdown" role="button" data-bs-toggle="dropdown">

            <i class="bi bi-globe"></i> <%= I18n.locale.to_s.upcase %>

          </a>

          <ul class="dropdown-menu">

            <li><%= link_to "English", url_for(request.params.merge(locale: "en")), class: "dropdown-item #{'active' if I18n.locale.to_s == 'en'}" %></li>

            <li><%= link_to "Español", url_for(request.params.merge(locale: "es")), class: "dropdown-item #{'active' if I18n.locale == :es}" %></li>

            <li><%= link_to "Kiswahili", url_for(request.params.merge(locale: "sw")), class: "dropdown-item #{'active' if I18n.locale == :sw}" %></li>

            <li><%= link_to "Français", url_for(request.params.merge(locale: "fr")), class: "dropdown-item #{'active' if I18n.locale == :fr}" %></li>

            <li><%= link_to "Deutsch", url_for(request.params.merge(locale: "de")), class: "dropdown-item #{'active' if I18n.locale == :de}" %></li>

            <li><%= link_to "中文 (Chinese)", url_for(request.params.merge(locale: "zh")), class: "dropdown-item #{'active' if I18n.locale == :zh}" %></li>

            <li><%= link_to "日本語 (Japanese)", url_for(request.params.merge(locale: "ja")), class: "dropdown-item #{'active' if I18n.locale == :ja}" %></li>

            <li><%= link_to "العربية (Arabic)", url_for(request.params.merge(locale: "ar")), class: "dropdown-item #{'active' if I18n.locale == :ar}" %></li>

            <li><%= link_to "Português", url_for(request.params.merge(locale: "pt")), class: "dropdown-item #{'active' if I18n.locale == :pt}" %></li>

            <li><%= link_to "Русский", url_for(request.params.merge(locale: "ru")), class: "dropdown-item #{'active' if I18n.locale == :ru}" %></li>

          </ul>

        </li>



        <!-- Currency Switcher -->

        <li class="nav-item dropdown">

          <a class="nav-link dropdown-toggle" href="#" id="currencyDropdown" role="button" data-bs-toggle="dropdown">

            <%= current_currency %>

          </a>

          <ul class="dropdown-menu">

             <li><%= link_to "KES", url_for(request.params.merge(currency: "KES")), class: "dropdown-item #{'active' if current_currency == 'KES'}" %></li>

             <li><%= link_to "USD", url_for(request.params.merge(currency: "USD")), class: "dropdown-item #{'active' if current_currency == 'USD'}" %></li>

             <li><%= link_to "EUR", url_for(request.params.merge(currency: "EUR")), class: "dropdown-item #{'active' if current_currency == 'EUR'}" %></li>

             <li><%= link_to "GBP", url_for(request.params.merge(currency: "GBP")), class: "dropdown-item #{'active' if current_currency == 'GBP'}" %></li>

             <li><%= link_to "JPY", url_for(request.params.merge(currency: "JPY")), class: "dropdown-item #{'active' if current_currency == 'JPY'}" %></li>

             <li><%= link_to "CNY", url_for(request.params.merge(currency: "CNY")), class: "dropdown-item #{'active' if current_currency == 'CNY'}" %></li>

             <li><%= link_to "INR", url_for(request.params.merge(currency: "INR")), class: "dropdown-item #{'active' if current_currency == 'INR'}" %></li>

             <li><%= link_to "CAD", url_for(request.params.merge(currency: "CAD")), class: "dropdown-item #{'active' if current_currency == 'CAD'}" %></li>

             <li><%= link_to "AUD", url_for(request.params.merge(currency: "AUD")), class: "dropdown-item #{'active' if current_currency == 'AUD'}" %></li>

             <li><%= link_to "ZAR", url_for(request.params.merge(currency: "ZAR")), class: "dropdown-item #{'active' if current_currency == 'ZAR'}" %></li>

          </ul>

        </li>

        <!-- Dark Mode Toggle -->
        <li class="nav-item">
          <button class="theme-toggle nav-link" id="themeToggleBtn" onclick="toggleDarkMode()" title="Toggle dark mode">
            <i class="bi bi-moon-fill"></i>
          </button>
        </li>

        <% if user_signed_in? %>

          <% if current_user.admin? %>
          <li class="nav-item">
            <%= link_to admin_root_path, class: "nav-link" do %>
              <i class="bi bi-shield-lock me-1"></i> Admin
            <% end %>
          </li>
          <% end %>

          <li class="nav-item" id="cart-nav-item">
            <%= render "shared/cart_badge" %>
          </li>

          <li class="nav-item dropdown">

            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">

              <%= current_user.name || current_user.email %>

            </a>

            <ul class="dropdown-menu dropdown-menu-end">
              <li><%= link_to profile_path, class: "dropdown-item" do %><i class="bi bi-person me-2"></i>My Account<% end %></li>
              <li><%= link_to orders_path, class: "dropdown-item" do %><i class="bi bi-receipt me-2"></i><%= t("my_orders") %><% end %></li>
              <li><%= link_to wishlist_items_path, class: "dropdown-item" do %><i class="bi bi-heart me-2"></i><%= t("my_wishlist") %><% end %></li>
              <li><%= link_to comparison_path, class: "dropdown-item" do %><i class="bi bi-arrow-left-right me-2"></i>Compare<% end %></li>
              <li><%= link_to gift_cards_path, class: "dropdown-item" do %><i class="bi bi-gift me-2"></i>Gift Cards<% end %></li>
              <li><%= link_to loyalty_path, class: "dropdown-item" do %><i class="bi bi-star me-2"></i>My Rewards<% end %></li>
              <li><%= link_to return_requests_path, class: "dropdown-item" do %><i class="bi bi-arrow-return-left me-2"></i>My Returns<% end %></li>
              <li><hr class="dropdown-divider"></li>
              <li><%= link_to edit_user_registration_path, class: "dropdown-item" do %><i class="bi bi-gear me-2"></i><%= t("edit_profile") %><% end %></li>
              <li><%= button_to destroy_user_session_path, method: :delete, class: "dropdown-item text-danger" do %><i class="bi bi-box-arrow-right me-2"></i><%= t("logout") %><% end %></li>
            </ul>

          </li>

        <% else %>

          <li class="nav-item">

            <%= link_to t("login"), new_user_session_path, class: "nav-link" %>

          </li>

          <li class="nav-item">

            <%= link_to t("signup"), new_user_registration_path, class: "nav-link" %>

          </li>

          <li class="nav-item" id="cart-nav-item-guest">
            <%= render "shared/cart_badge" %>
          </li>

        <% end %>

      </ul>

    </div>

  </div>

</nav>



    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <div class="container mb-5">
      <% if notice %>
        <%= render partial: "shared/toast", locals: { message: notice, toast_type: "success" } %>
      <% end %>

      <% if alert %>
        <%= render partial: "shared/toast", locals: { message: alert, toast_type: "error" } %>
      <% end %>

      <div class="page-content">
        <%= yield %>
      </div>
    </div>

    <!-- Scroll to Top -->
    <button class="scroll-to-top" id="scrollToTop" title="Back to top">
      <i class="bi bi-arrow-up"></i>
    </button>

    <!-- Cookie Consent Banner -->
    <div id="cookieConsent" class="cookie-consent" style="display: none;">
      <div class="cookie-content">
        <i class="bi bi-cookie me-2 text-warning fs-4"></i>
        <span>
          We use cookies to improve your experience. By continuing to visit this site you agree to our use of cookies.
          <%= link_to "Learn more", privacy_policy_path, class: "text-white text-decoration-underline" %>
        </span>
      </div>
      <div class="cookie-actions ms-3">
        <button id="acceptCookies" class="btn btn-primary btn-sm rounded-pill px-4">Accept</button>
      </div>
    </div>

    <footer class="footer-modern">
      <div class="container">
        <!-- Footer Top -->
        <div class="footer-top">
          <div class="row g-4">
            <!-- Brand -->
            <div class="col-lg-3 col-md-6">
              <div class="footer-brand">
                <h4><i class="bi bi-shop me-2"></i><%= t('app_name') %></h4>
                <p>Bringing the best of Kenya to your doorstep. Quality products, secure payments, and fast delivery.</p>
                <div class="social-links">
                  <a href="https://twitter.com/ecommerce_store" target="_blank" rel="noopener noreferrer" class="social-btn" title="Twitter"><i class="bi bi-twitter-x"></i></a>
                  <a href="https://facebook.com/ecommerce_store" target="_blank" rel="noopener noreferrer" class="social-btn" title="Facebook"><i class="bi bi-facebook"></i></a>
                  <a href="https://instagram.com/ecommerce_store" target="_blank" rel="noopener noreferrer" class="social-btn" title="Instagram"><i class="bi bi-instagram"></i></a>
                  <a href="https://tiktok.com/@ecommerce_store" target="_blank" rel="noopener noreferrer" class="social-btn" title="TikTok"><i class="bi bi-tiktok"></i></a>
                </div>
              </div>
            </div>

            <!-- Shop -->
            <div class="col-lg-2 col-md-6 col-6">
              <h6 class="footer-title">Shop</h6>
              <ul class="footer-links">
                <li><%= link_to products_path do %><i class="bi bi-grid me-2"></i><%= t('products') %><% end %></li>
                <li><%= link_to categories_path do %><i class="bi bi-collection me-2"></i><%= t('categories') %><% end %></li>
                <li><%= link_to product_bundles_path do %><i class="bi bi-box-seam me-2"></i>Bundle Deals<% end %></li>
                <li><%= link_to flash_sales_path do %><i class="bi bi-lightning me-2"></i>Flash Sales<% end %></li>
                <li><%= link_to blog_posts_path do %><i class="bi bi-journal-text me-2"></i>Blog<% end %></li>
                <li><%= link_to gift_cards_path do %><i class="bi bi-gift me-2"></i>Gift Cards<% end %></li>
                <li><%= link_to comparison_path do %><i class="bi bi-arrow-left-right me-2"></i>Compare<% end %></li>
              </ul>
            </div>

            <!-- Account -->
            <div class="col-lg-2 col-md-6 col-6">
              <h6 class="footer-title">Account</h6>
              <ul class="footer-links">
                <% if user_signed_in? %>
                  <li><%= link_to profile_path do %><i class="bi bi-person me-2"></i>Profile<% end %></li>
                  <li><%= link_to orders_path do %><i class="bi bi-receipt me-2"></i>Orders<% end %></li>
                  <li><%= link_to wishlist_items_path do %><i class="bi bi-heart me-2"></i>Wishlist<% end %></li>
                  <li><%= link_to loyalty_path do %><i class="bi bi-star me-2"></i>My Rewards<% end %></li>
                  <li><%= link_to return_requests_path do %><i class="bi bi-arrow-return-left me-2"></i>Returns<% end %></li>
                <% else %>
                  <li><%= link_to new_user_session_path do %><i class="bi bi-box-arrow-in-right me-2"></i>Login<% end %></li>
                  <li><%= link_to new_user_registration_path do %><i class="bi bi-person-plus me-2"></i>Register<% end %></li>
                <% end %>
              </ul>
            </div>

            <!-- Support -->
            <div class="col-lg-2 col-md-6 col-6">
              <h6 class="footer-title">Support</h6>
              <ul class="footer-links">
                <li><%= link_to new_contact_message_path do %><i class="bi bi-headset me-2"></i>Contact Us<% end %></li>
                <li><%= link_to faq_path do %><i class="bi bi-question-circle me-2"></i>FAQ<% end %></li>
                <li><%= link_to shipping_info_path do %><i class="bi bi-truck me-2"></i>Shipping<% end %></li>
                <li><%= link_to about_path do %><i class="bi bi-info-circle me-2"></i>About Us<% end %></li>
              </ul>
            </div>

            <!-- Newsletter -->
            <div class="col-lg-3 col-md-6">
              <h6 class="footer-title">Stay Connected</h6>
              <p class="footer-newsletter-text">Subscribe for exclusive deals and new arrivals.</p>
              <%= form_with model: Subscriber.new, url: subscribers_path, class: "footer-newsletter-form" do |f| %>
                <div class="footer-input-wrap">
                  <%= f.email_field :email, class: "footer-email-input", placeholder: "Your email address", required: true %>
                  <%= f.submit "→", class: "footer-subscribe-btn" %>
                </div>
              <% end %>
              <div class="footer-trust mt-3">
                <span><i class="bi bi-shield-check me-1"></i>Secure Payments</span>
                <span><i class="bi bi-truck me-1"></i>Fast Delivery</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Footer Bottom / Policies -->
        <div class="footer-bottom">
          <div class="footer-bottom-left">
            <span>&copy; <%= Time.current.year %> <%= t('app_name') %>. <%= t('footer_rights') %></span>
          </div>
          <div class="footer-bottom-right">
            <%= link_to 'Privacy', privacy_policy_path %>
            <%= link_to 'Terms', terms_path %>
            <%= link_to 'Returns', return_policy_path %>
          </div>
        </div>
      </div>
    </footer>



    <script>
      // ====== Dark Mode Toggle ======
      function initDarkMode() {
        var saved = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', saved);
        document.documentElement.setAttribute('data-bs-theme', saved);
        updateThemeIcon(saved);
      }
      function toggleDarkMode() {
        var current = document.documentElement.getAttribute('data-theme');
        var next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        document.documentElement.setAttribute('data-bs-theme', next);
        localStorage.setItem('theme', next);
        updateThemeIcon(next);
      }
      function updateThemeIcon(theme) {
        var btn = document.getElementById('themeToggleBtn');
        if (btn) {
          btn.innerHTML = theme === 'dark'
            ? '<i class="bi bi-sun-fill"></i>'
            : '<i class="bi bi-moon-fill"></i>';
        }
      }

      // ====== Scroll to Top ======
      function initScrollToTop() {
        var btn = document.getElementById('scrollToTop');
        if (!btn) return;
        window.addEventListener('scroll', function() {
          if (window.scrollY > 400) btn.classList.add('visible');
          else btn.classList.remove('visible');
        });
        btn.addEventListener('click', function() {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      // ====== Cart Badge Pulse ======
      function initCartBadge() {
        document.querySelectorAll('.badge.rounded-pill.bg-danger').forEach(function(badge) {
          badge.classList.add('cart-badge-pulse');
        });
      }

      // ====== Password Toggles ======
      function setupPasswordToggles() {
        function setupPasswordToggle(passwordId, buttonId, iconId) {
          var button = document.getElementById(buttonId);
          if (button) {
            button.replaceWith(button.cloneNode(true));
            var newButton = document.getElementById(buttonId);
            newButton.addEventListener('click', function(e) {
              e.preventDefault();
              var passwordField = document.getElementById(passwordId);
              var eyeIcon = document.getElementById(iconId);
              if (passwordField && eyeIcon) {
                if (passwordField.type === 'password') {
                  passwordField.type = 'text';
                  eyeIcon.classList.remove('bi-eye');
                  eyeIcon.classList.add('bi-eye-slash');
                } else {
                  passwordField.type = 'password';
                  eyeIcon.classList.remove('bi-eye-slash');
                  eyeIcon.classList.add('bi-eye');
                }
              }
            });
          }
        }
        setupPasswordToggle('login-password', 'toggle-login-password', 'login-eye-icon');
        setupPasswordToggle('signup-password', 'toggle-signup-password', 'signup-eye-icon');
        setupPasswordToggle('signup-password-confirm', 'toggle-signup-password-confirm', 'signup-confirm-eye-icon');
        setupPasswordToggle('reset-password', 'toggle-reset-password', 'reset-eye-icon');
        setupPasswordToggle('reset-password-confirm', 'toggle-reset-password-confirm', 'reset-confirm-eye-icon');
      }

      // ====== Cookie Consent ======
      function initCookieConsent() {
        var banner = document.getElementById('cookieConsent');
        var btn = document.getElementById('acceptCookies');
        if (!banner || !btn) return;
        
        if (!localStorage.getItem('cookiesAccepted')) {
          setTimeout(function() {
            banner.style.display = 'flex';
          }, 1000);
        }
        
        btn.addEventListener('click', function() {
          localStorage.setItem('cookiesAccepted', 'true');
          banner.style.animation = 'slideDown 0.4s ease-in forwards';
          setTimeout(function() { banner.style.display = 'none'; }, 400);
        });
      }

      // ====== Init All ======
      function initAllFeatures() {
        initDarkMode();
        initScrollToTop();
        initCartBadge();
        setupPasswordToggles();
        initCookieConsent();
      }

      // Run on page load + Turbo navigations
      initDarkMode(); // Run immediately to prevent flash
      document.addEventListener('DOMContentLoaded', initAllFeatures);
      document.addEventListener('turbo:load', initAllFeatures);
      document.addEventListener('turbo:render', initAllFeatures);
    </script>

    <%= render "shared/ai_chat" %>
  </body>
</html>
