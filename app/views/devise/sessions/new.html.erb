<% content_for :title, "Sign In — #{t('app_name')}" %>

<div class="auth-page">
  <div class="container">
    <div class="auth-wrapper">
      <div class="auth-card">
        <div class="auth-header text-center">
          <div class="auth-icon">
            <i class="bi bi-person-circle"></i>
          </div>
          <h2>Welcome Back</h2>
          <p class="text-muted">Sign in to your account to continue</p>
        </div>

        <div class="auth-body">
          <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
            <div class="form-group-modern">
              <%= f.label :email, class: "form-label-modern" do %>
                <i class="bi bi-envelope me-1"></i> Email Address
              <% end %>
              <%= f.email_field :email,
                    autofocus: true,
                    autocomplete: "email",
                    class: "form-input-modern",
                    placeholder: "your@email.com",
                    required: true %>
            </div>

            <div class="form-group-modern">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <%= f.label :password, class: "form-label-modern mb-0" do %>
                  <i class="bi bi-lock me-1"></i> Password
                <% end %>
                <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
                  <%= link_to "Forgot password?", new_password_path(resource_name), class: "auth-forgot-link" %>
                <% end %>
              </div>
              <div class="input-pw-wrap">
                <%= f.password_field :password,
                      autocomplete: "current-password",
                      class: "form-input-modern",
                      id: "login-password",
                      placeholder: "Enter your password",
                      required: true %>
                <button class="pw-toggle-btn" type="button" onclick="togglePw('login-password', this)" tabindex="-1">
                  <i class="bi bi-eye"></i>
                </button>
              </div>
            </div>

            <% if devise_mapping.rememberable? %>
              <div class="form-check auth-check mb-4">
                <%= f.check_box :remember_me, class: "form-check-input", id: "remember_me" %>
                <%= f.label :remember_me, class: "form-check-label text-muted", for: "remember_me" %>
              </div>
            <% end %>

            <%= f.submit "Sign In", class: "btn-auth-primary w-100" %>
          <% end %>

          <!-- Social Login -->
          <% if devise_mapping.omniauthable? %>
            <div class="auth-divider">
              <span>or continue with</span>
            </div>
            
            <div class="social-login-grid">
              <%= button_to user_google_oauth2_omniauth_authorize_path, method: :post, class: "btn-social google", data: { turbo: false } do %>
                <i class="bi bi-google me-2"></i> Google
              <% end %>
              
              <%= button_to user_github_omniauth_authorize_path, method: :post, class: "btn-social github", data: { turbo: false } do %>
                <i class="bi bi-github me-2"></i> GitHub
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="auth-footer text-center mt-4">
          <p class="text-muted mb-0">
            Don't have an account? 
            <%= link_to "Sign up now", new_registration_path(resource_name), class: "auth-link-bold" %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function togglePw(fieldId, btn) {
    var field = document.getElementById(fieldId);
    var icon = btn.querySelector('i');
    if (!field) return;
    if (field.type === 'password') {
      field.type = 'text';
      icon.className = 'bi bi-eye-slash';
    } else {
      field.type = 'password';
      icon.className = 'bi bi-eye';
    }
  }
</script>

<style>
.auth-page { padding: 60px 0; min-height: 80vh; background: var(--bg-primary, #f8fafc); display: flex; align-items: center; }
.auth-wrapper { max-width: 480px; margin: 0 auto; width: 100%; }
.auth-card {
  background: white; border-radius: 24px; padding: 40px;
  box-shadow: 0 10px 40px rgba(0,0,0,0.08); border: 1px solid rgba(0,0,0,0.02);
}
.auth-icon {
  width: 64px; height: 64px; margin: 0 auto 20px; border-radius: 50%;
  background: linear-gradient(135deg, rgba(102,126,234,0.1), rgba(118,75,162,0.1));
  color: #667eea; display: flex; align-items: center; justify-content: center;
  font-size: 2rem;
}
.auth-header h2 { font-weight: 800; color: #1e293b; margin-bottom: 8px; font-size: 1.8rem; }
.auth-body { margin-top: 30px; }

.form-group-modern { margin-bottom: 24px; }
.form-label-modern { font-size: 0.9rem; font-weight: 600; color: #374151; display: flex; align-items: center; margin-bottom: 8px; }
.form-input-modern {
  width: 100%; padding: 12px 16px; font-size: 1rem;
  border: 2px solid #e2e8f0; border-radius: 12px;
  background: #f8fafc; color: #1e293b; outline: none;
  transition: all 0.2s; box-sizing: border-box;
}
.form-input-modern:focus { border-color: #667eea; background: white; box-shadow: 0 0 0 4px rgba(102,126,234,0.1); }
.form-input-modern::placeholder { color: #94a3b8; }

.input-pw-wrap { position: relative; }
.input-pw-wrap .form-input-modern { padding-right: 44px; }
.pw-toggle-btn {
  position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
  background: none; border: none; color: #94a3b8; cursor: pointer;
  font-size: 1.1rem; padding: 4px; display: flex; align-items: center;
}
.pw-toggle-btn:hover { color: #667eea; }

.auth-forgot-link { font-size: 0.85rem; color: #667eea; text-decoration: none; font-weight: 600; }
.auth-forgot-link:hover { text-decoration: underline; }

.auth-check .form-check-input { cursor: pointer; width: 18px; height: 18px; margin-top: 3px; }
.auth-check .form-check-input:checked { background-color: #667eea; border-color: #667eea; }
.auth-check .form-check-label { cursor: pointer; font-size: 0.9rem; padding-left: 4px; }

.btn-auth-primary {
  padding: 14px; background: linear-gradient(135deg, #667eea, #764ba2);
  color: white; border: none; border-radius: 12px; font-weight: 700;
  font-size: 1rem; cursor: pointer; transition: all 0.2s;
}
.btn-auth-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(102,126,234,0.3); }

.auth-divider {
  display: flex; align-items: center; text-align: center; margin: 30px 0; color: #94a3b8; font-size: 0.85rem;
}
.auth-divider::before, .auth-divider::after {
  content: ''; flex: 1; border-bottom: 1px solid #e2e8f0;
}
.auth-divider span { padding: 0 16px; font-weight: 500; }

.social-login-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
@media (max-width: 480px) { .social-login-grid { grid-template-columns: 1fr; } }

.btn-social {
  width: 100%; padding: 12px; display: flex; align-items: center; justify-content: center;
  border-radius: 12px; font-weight: 600; font-size: 0.95rem; cursor: pointer;
  transition: all 0.2s; border: 2px solid #e2e8f0; background: white; color: #334155;
}
.btn-social:hover { background: #f8fafc; border-color: #cbd5e1; transform: translateY(-1px); }
.btn-social.google { color: #db4437; }
.btn-social.github { color: #333; }

.auth-link-bold { color: #667eea; font-weight: 700; text-decoration: none; transition: color 0.2s; }
.auth-link-bold:hover { color: #5a67d8; text-decoration: underline; }
</style>