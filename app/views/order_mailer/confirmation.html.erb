<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
    <style>
      body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; background-color: #f7f9fc; margin: 0; padding: 0; color: #333; }
      .container { max-width: 600px; margin: 40px auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
      .header { background-color: #4f46e5; padding: 30px 20px; text-align: center; color: white; }
      .header h1 { margin: 0; font-size: 24px; font-weight: 700; }
      .content { padding: 30px; }
      .content p { font-size: 16px; line-height: 1.6; }
      .table { width: 100%; border-collapse: collapse; margin-top: 20px; margin-bottom: 20px; }
      .table th { background-color: #f8fafc; color: #64748b; font-size: 14px; text-transform: uppercase; padding: 12px; text-align: left; border-bottom: 1px solid #e2e8f0; }
      .table td { padding: 15px 12px; border-bottom: 1px solid #e2e8f0; font-size: 15px; }
      .summary-box { background-color: #f8fafc; padding: 20px; border-radius: 8px; margin-top: 20px; }
      .summary-row { display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 15px; }
      .total-row { font-size: 18px; font-weight: bold; border-top: 1px solid #e2e8f0; padding-top: 10px; margin-top: 10px; color: #1e293b; }
      .footer { background-color: #f1f5f9; padding: 20px; text-align: center; color: #64748b; font-size: 14px; }
      .btn { display: inline-block; padding: 12px 24px; background-color: #4f46e5; color: white; text-decoration: none; border-radius: 6px; font-weight: bold; margin-top: 20px; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Order Confirmed! 🎉</h1>
      </div>
      <div class="content">
        <p>Hi <%= @order.name %>,</p>
        <p>Thank you for your order! We've successfully received it and are now preparing it for shipment. Here are your order details:</p>
        
        <p><strong>Order Number:</strong> #<%= @order.id %><br>
        <strong>Order Date:</strong> <%= @order.created_at.strftime("%B %d, %Y") %><br>
        <strong>Shipping Address:</strong> <%= @order.address %></p>

        <table class="table">
          <thead>
            <tr>
              <th>Item</th>
              <th style="text-align: right;">Price</th>
            </tr>
          </thead>
          <tbody>
            <% @order.order_items.each do |item| %>
              <tr>
                <td>
                  <strong><%= item.variant.product.name %></strong><br>
                  <small style="color: #64748b;"><%= item.variant.name %> (x<%= item.quantity %>)</small>
                </td>
                <td style="text-align: right;"><%= number_to_currency(item.price * item.quantity, unit: 'KSh ') %></td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <div class="summary-box">
          <table style="width: 100%;">
            <tr>
              <td style="padding: 5px 0;">Subtotal:</td>
              <td style="text-align: right;"><%= number_to_currency(@order.order_items.sum { |i| i.price * i.quantity }, unit: 'KSh ') %></td>
            </tr>
            <% if @order.discount_amount.to_d > 0 %>
              <tr>
                <td style="padding: 5px 0; color: #16a34a;">Discount (<%= @order.promo_code&.code %>):</td>
                <td style="text-align: right; color: #16a34a;">-<%= number_to_currency(@order.discount_amount, unit: 'KSh ') %></td>
              </tr>
            <% end %>
            <tr>
              <td style="padding: 5px 0;">Shipping (<%= @order.shipping_method&.name || 'Standard' %>):</td>
              <td style="text-align: right;"><%= @order.shipping_cost.to_d > 0 ? number_to_currency(@order.shipping_cost, unit: 'KSh ') : 'Free' %></td>
            </tr>
            <tr>
              <td style="padding: 5px 0;">Tax (<%= (@order.tax_rate.to_f * 100).to_i %>% VAT):</td>
              <td style="text-align: right;"><%= number_to_currency(@order.tax_amount, unit: 'KSh ') %></td>
            </tr>
            <tr>
              <td style="padding: 10px 0; font-weight: bold; font-size: 18px; border-top: 1px solid #e2e8f0; margin-top: 10px;">Total Paid:</td>
              <td style="text-align: right; font-weight: bold; font-size: 18px; border-top: 1px solid #e2e8f0; margin-top: 10px; color: #4f46e5;"><%= number_to_currency(@order.total_price, unit: 'KSh ') %></td>
            </tr>
          </table>
        </div>

        <div style="text-align: center;">
          <%= link_to 'View Order Status', order_url(@order), class: 'btn' %>
        </div>
      </div>
      <div class="footer">
        <p>If you have any questions, reply to this email or contact our support.</p>
        <p>&copy; <%= Time.current.year %> Larry Commerce. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>
