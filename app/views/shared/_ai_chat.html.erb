<!-- AI Chat floating bubble widget -->
<style>
  .ai-chat-widget {
    position: fixed;
    bottom: 30px;
    left: 30px;
    z-index: 9999;
    font-family: 'Inter', sans-serif;
  }
  
  .ai-chat-btn {
    width: 60px;
    height: 60px;
    border-radius: 30px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    box-shadow: 0 4px 20px rgba(118, 75, 162, 0.4);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s;
  }
  
  .ai-chat-btn:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 25px rgba(118, 75, 162, 0.6);
  }

  .ai-chat-panel {
    position: absolute;
    bottom: 80px;
    left: 0;
    width: 350px;
    height: 480px;
    background: var(--bg-card);
    border-radius: 20px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.2);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: translateY(20px) scale(0.95) rotate(-2deg);
    opacity: 0;
    pointer-events: none;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    transform-origin: bottom left;
    border: 1px solid var(--border-color);
  }
  
  .ai-chat-panel.active {
    transform: translateY(0) scale(1) rotate(0deg);
    opacity: 1;
    pointer-events: auto;
  }

  .ai-chat-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .ai-chat-header-title {
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 16px;
  }
  
  .ai-chat-close {
    background: rgba(255,255,255,0.2);
    border: none;
    color: white;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }
  .ai-chat-close:hover { background: rgba(255,255,255,0.4); }

  .ai-chat-messages {
    flex: 1;
    padding: 16px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--bg-primary);
  }
  
  .chat-msg {
    max-width: 85%;
    padding: 10px 14px;
    border-radius: 16px;
    font-size: 14px;
    line-height: 1.4;
    animation: slideInChat 0.3s ease-out;
  }
  
  .chat-msg.user {
    align-self: flex-end;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border-bottom-right-radius: 4px;
  }
  
  .chat-msg.bot {
    align-self: flex-start;
    background: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    border-bottom-left-radius: 4px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.02);
  }
  
  .chat-typing {
    align-self: flex-start;
    background: var(--bg-card);
    padding: 12px 16px;
    border-radius: 16px;
    border-bottom-left-radius: 4px;
    display: flex;
    gap: 4px;
    align-items: center;
    border: 1px solid var(--border-color);
    display: none;
  }
  
  .typing-dot {
    width: 6px; height: 6px; border-radius: 50%; background: var(--text-muted);
    animation: typingPulse 1.4s infinite ease-in-out both;
  }
  .typing-dot:nth-child(1) { animation-delay: -0.32s; }
  .typing-dot:nth-child(2) { animation-delay: -0.16s; }
  
  @keyframes typingPulse {
    0%, 80%, 100% { transform: scale(0); }
    40% { transform: scale(1); }
  }
  
  @keyframes slideInChat {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .ai-chat-input-area {
    padding: 12px;
    background: var(--bg-card);
    border-top: 1px solid var(--border-color);
    display: flex;
    gap: 8px;
  }
  
  .ai-chat-input {
    flex: 1;
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 10px 16px;
    font-size: 14px;
    outline: none;
    background: var(--bg-primary);
    color: var(--text-primary);
    transition: border-color 0.2s;
  }
  
  .ai-chat-input:focus {
    border-color: #667eea;
  }
  
  .ai-chat-send {
    width: 42px;
    height: 42px;
    border-radius: 21px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s;
  }
  .ai-chat-send:hover { transform: scale(1.05); }
  
  @media (max-width: 576px) {
    .ai-chat-panel {
      bottom: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      border-radius: 0;
      position: fixed;
    }
    .ai-chat-widget {
      bottom: 20px;
      left: 20px;
    }
  }
</style>

<div class="ai-chat-widget">
  <button class="ai-chat-btn" id="aiChatOpenBtn" onclick="toggleAIChat()" title="Chat with AI Support">
    <i class="bi bi-robot"></i>
  </button>
  
  <div class="ai-chat-panel" id="aiChatPanel">
    <div class="ai-chat-header">
      <h5 class="ai-chat-header-title"><i class="bi bi-stars"></i> E-Commerce KE Assistant</h5>
      <button class="ai-chat-close" onclick="toggleAIChat()">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>
    
    <div class="ai-chat-messages" id="aiChatMessages">
      <div class="chat-msg bot">
        Hello! I'm your AI shopping assistant. Ask me about products, shipping, returns, or payment help.
      </div>
      
      <div class="chat-typing" id="aiChatTyping">
        <div class="typing-dot"></div>
        <div class="typing-dot"></div>
        <div class="typing-dot"></div>
      </div>
    </div>
    
    <div class="ai-chat-input-area">
      <input type="text" id="aiChatInput" class="ai-chat-input" maxlength="1000" placeholder="Ask about products, shipping..." onkeypress="handleAIChatKeyPress(event)">
      <button class="ai-chat-send" id="aiChatSendBtn" onclick="sendAIChatMessage()">
        <i class="bi bi-send-fill"></i>
      </button>
    </div>
  </div>
</div>

<script>
  let aiChatSending = false;

  function toggleAIChat() {
    const panel = document.getElementById('aiChatPanel');
    const btn = document.getElementById('aiChatOpenBtn');
    
    if (panel.classList.contains('active')) {
      panel.classList.remove('active');
      btn.style.transform = 'scale(1)';
    } else {
      panel.classList.add('active');
      btn.style.transform = 'scale(0)';
      setTimeout(() => document.getElementById('aiChatInput').focus(), 400);
    }
  }

  function handleAIChatKeyPress(e) {
    if (e.key === 'Enter') {
      sendAIChatMessage();
    }
  }

  function appendBotMessage(text, isError = false) {
    const messagesContainer = document.getElementById('aiChatMessages');
    const typingIndicator = document.getElementById('aiChatTyping');
    const botBubble = document.createElement('div');
    botBubble.className = 'chat-msg bot';
    if (isError) {
      botBubble.style.color = '#ef4444';
    }
    botBubble.innerText = text;
    messagesContainer.insertBefore(botBubble, typingIndicator);
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  }

  async function sendAIChatMessage() {
    if (aiChatSending) return;

    const input = document.getElementById('aiChatInput');
    const sendBtn = document.getElementById('aiChatSendBtn');
    const message = input.value.trim();
    if (!message) {
      appendBotMessage('Please type a message first.', true);
      return;
    }

    if (message.length > 1000) {
      appendBotMessage('Message is too long. Please keep it under 1000 characters.', true);
      return;
    }
    
    const messagesContainer = document.getElementById('aiChatMessages');
    const typingIndicator = document.getElementById('aiChatTyping');
    
    // Add user message
    const userBubble = document.createElement('div');
    userBubble.className = 'chat-msg user';
    userBubble.innerText = message;
    messagesContainer.insertBefore(userBubble, typingIndicator);
    
    input.value = '';
    messagesContainer.scrollTop = messagesContainer.scrollHeight;

    aiChatSending = true;
    input.disabled = true;
    sendBtn.disabled = true;
    
    // Show typing
    typingIndicator.style.display = 'flex';
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
    
    try {
      const response = await fetch('/api/v1/ai/chat', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ message: message })
      });
      
      const data = await response.json();
      typingIndicator.style.display = 'none';

      if (!response.ok) {
        appendBotMessage(data.error || 'Sorry, I could not process that request right now.', true);
      } else {
        appendBotMessage(data.reply || data.error || "Sorry, I couldn't process that.");
      }
      
    } catch (error) {
      typingIndicator.style.display = 'none';
      appendBotMessage('Network error. Please check your connection and try again.', true);
    } finally {
      aiChatSending = false;
      input.disabled = false;
      sendBtn.disabled = false;
      input.focus();
    }
  }
</script>
