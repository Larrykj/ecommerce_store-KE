<div style="text-align: center; padding: 80px 20px; min-height: 60vh; display: flex; align-items: center; justify-content: center;">
  <div>
    <div style="width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, #10b981, #059669); color: white; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 24px;">
      <i class="bi bi-check-lg"></i>
    </div>
    <h1 style="font-size: 2rem; font-weight: 800; color: #1e293b; margin-bottom: 12px;">Message Sent!</h1>
    <p style="color: #64748b; font-size: 1.1rem; max-width: 500px; margin: 0 auto 32px; line-height: 1.6;">
      Thank you for reaching out to us. Our support team will get back to you within 24 hours.
    </p>
    <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
      <%= link_to products_path, style: "display: inline-flex; align-items: center; padding: 12px 24px; background: linear-gradient(135deg, #667eea, #764ba2); color: white; border-radius: 12px; text-decoration: none; font-weight: 700; transition: all 0.2s;" do %>
        <i class="bi bi-bag me-2"></i>Continue Shopping
      <% end %>
      <%= link_to orders_path, style: "display: inline-flex; align-items: center; padding: 12px 24px; background: #f1f5f9; color: #475569; border-radius: 12px; text-decoration: none; font-weight: 600;" do %>
        <i class="bi bi-receipt me-2"></i>View Orders
      <% end %>
    </div>
  </div>
</div>
