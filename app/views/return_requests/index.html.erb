<%= render "pages/shared_styles" %>
<div class="container py-5" style="max-width: 900px;">
  <h2 class="fw-bold mb-4"><i class="bi bi-arrow-return-left me-2 text-primary"></i>My Return Requests</h2>

  <% if @return_requests.any? %>
    <div class="list-group">
      <% @return_requests.each do |rr| %>
        <div class="list-group-item p-4" style="border-radius: 12px; margin-bottom: 12px; border: 2px solid #f1f5f9;">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h6 class="fw-bold mb-1">Order #<%= rr.order_id %></h6>
              <p class="text-muted mb-1 small"><%= rr.reason %></p>
              <p class="mb-0 small"><%= rr.description.truncate(100) %></p>
            </div>
            <div class="text-end">
              <% badge_class = { "pending" => "bg-warning text-dark", "approved" => "bg-success", "rejected" => "bg-danger", "completed" => "bg-info" } %>
              <span class="badge rounded-pill <%= badge_class[rr.status] || 'bg-secondary' %>"><%= rr.status.capitalize %></span>
              <br><small class="text-muted"><%= rr.created_at.strftime("%b %d, %Y") %></small>
            </div>
          </div>
          <% if rr.admin_notes.present? %>
            <div class="mt-3 p-3 rounded" style="background: #f8fafc;">
              <small class="fw-bold text-primary">Admin Response:</small>
              <p class="mb-0 small"><%= rr.admin_notes %></p>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-5" style="background: #f8fafc; border-radius: 16px;">
      <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
      <h4 class="mt-3 fw-bold">No Return Requests</h4>
      <p class="text-muted">You haven't submitted any return requests yet.</p>
      <%= link_to "View My Orders", orders_path, class: "btn btn-outline-primary" %>
    </div>
  <% end %>
</div>
