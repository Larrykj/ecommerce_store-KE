<%= render "pages/shared_styles" %>
<div class="container py-5" style="max-width: 900px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-gift me-2 text-primary"></i>Gift Cards</h2>
    <%= link_to new_gift_card_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i>Purchase Gift Card
    <% end %>
  </div>

  <!-- Check Balance -->
  <div class="card mb-4 shadow-sm" style="border-radius: 16px; border: none;">
    <div class="card-body p-4">
      <h5 class="fw-bold mb-3"><i class="bi bi-search me-2"></i>Check Gift Card Balance</h5>
      <%= form_with url: check_gift_card_balance_path, method: :post, local: true, class: "d-flex gap-2" do |f| %>
        <%= f.text_field :code, class: "form-control", placeholder: "Enter gift card code (e.g., GC-XXXXXXXX)", style: "max-width: 400px;" %>
        <%= f.submit "Check Balance", class: "btn btn-outline-primary" %>
      <% end %>
      <% if defined?(@gift_card) && @gift_card %>
        <div class="mt-3 p-3 rounded" style="background: #d1fae5;">
          <strong>Balance: <%= @gift_card.formatted_balance %></strong>
          <span class="badge ms-2 <%= @gift_card.active? ? 'bg-success' : 'bg-secondary' %>"><%= @gift_card.status.capitalize %></span>
        </div>
      <% elsif params[:code].present? %>
        <div class="mt-3 p-3 rounded" style="background: #fee2e2;"><strong>Gift card not found.</strong></div>
      <% end %>
    </div>
  </div>

  <!-- My Gift Cards -->
  <% if @gift_cards.any? %>
    <div class="row g-3">
      <% @gift_cards.each do |gc| %>
        <div class="col-md-6">
          <div class="card h-100 shadow-sm" style="border-radius: 16px; border: 2px solid #f1f5f9; background: linear-gradient(135deg, #667eea10, #764ba210);">
            <div class="card-body p-4">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <code style="font-size: 1.1rem; font-weight: 700; color: #4f46e5;"><%= gc.code %></code>
                <span class="badge rounded-pill <%= gc.active? ? 'bg-success' : 'bg-secondary' %>"><%= gc.status.capitalize %></span>
              </div>
              <div class="mb-2">
                <span class="text-muted small">Balance:</span>
                <strong style="font-size: 1.3rem; color: #1e293b;"><%= gc.formatted_balance %></strong>
                <span class="text-muted small">/ KSh <%= gc.initial_value.to_i %></span>
              </div>
              <% if gc.recipient_email.present? %>
                <p class="text-muted small mb-1"><i class="bi bi-envelope me-1"></i>Sent to: <%= gc.recipient_email %></p>
              <% end %>
              <% if gc.expires_at %>
                <p class="text-muted small mb-0"><i class="bi bi-calendar me-1"></i>Expires: <%= gc.expires_at.strftime("%b %d, %Y") %></p>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-5" style="background: #f8fafc; border-radius: 16px;">
      <i class="bi bi-gift text-primary" style="font-size: 3rem;"></i>
      <h4 class="mt-3 fw-bold">No Gift Cards Yet</h4>
      <p class="text-muted">Purchase a gift card for someone special!</p>
    </div>
  <% end %>
</div>
