<% content_for :title, @post.title %>
<div class="container py-5">
  <nav aria-label="Blog navigation" class="mb-4">
    <ul class="nav">
      <li class="nav-item">
        <%= link_to "← Back to Blog", blog_posts_path, class: "nav-link" %>
      </li>
      <li class="nav-item">
        <%= link_to "Categories", blog_categories_path, class: "nav-link" %>
      </li>
    </ul>
  </nav>

  <article>
    <h1><%= @post.title %></h1>
    <p class="text-muted">
      <%= @post.published_at.strftime('%B %d, %Y') %> | <%= @post.category&.name || 'Uncategorized' %> | <%= @post.views_count %> views
    </p>
    
    <% if @post.featured_image %>
      <%= blog_featured_image_tag @post.featured_image, class: 'img-fluid mb-4 rounded' %>
    <% end %>
    
    <div class="blog-content">
      <%= sanitize(@post.content) %>
    </div>
  </article>
  
  <hr>
  
  <h3>Comments (<%= @comments.count %>)</h3>
  <% @comments.each do |comment| %>
    <div class="card mb-3">
      <div class="card-body">
        <strong><%= comment.user&.name || comment.name %></strong>
        <small class="text-muted"><%= comment.created_at.strftime('%B %d, %Y') %></small>
        <p><%= comment.content %></p>
      </div>
    </div>
  <% end %>
  
  <% if user_signed_in? %>
    <%= form_with model: [@post, BlogComment.new], local: true do |f| %>
      <div class="mb-3">
        <%= f.label :content, 'Leave a comment', class: 'form-label' %>
        <%= f.text_area :content, class: 'form-control', rows: 3 %>
      </div>
      <%= f.submit 'Post Comment', class: 'btn btn-primary' %>
    <% end %>
  <% else %>
    <p><%= link_to 'Login', new_user_session_path %> to post a comment.</p>
  <% end %>
</div>