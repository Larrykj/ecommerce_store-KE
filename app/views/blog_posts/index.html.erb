<% content_for :title, "Blog" %>
<div class="container py-5">
  <h1 class="mb-4">Blog</h1>
  
  <div class="row">
    <div class="col-md-8">
      <% @posts.each do |post| %>
        <article class="card mb-4">
          <% if post.featured_image %>
            <%= blog_featured_image_tag post.featured_image, class: 'card-img-top', style: 'max-height: 300px; object-fit: cover;' %>
          <% end %>
          <div class="card-body">
            <h2 class="card-title"><%= link_to post.title, blog_post_path(post) %></h2>
            <p class="text-muted">
              <%= post.published_at.strftime('%B %d, %Y') %> | <%= post.category&.name || 'Uncategorized' %>
            </p>
            <p class="card-text"><%= post.excerpt_text %></p>
            <%= link_to 'Read More', blog_post_path(post), class: 'btn btn-outline-primary' %>
          </div>
        </article>
      <% end %>
      <% if @pagy.pages > 1 %>
        <div class="mt-4">
          <%== @pagy.series_nav(:bootstrap) %>
        </div>
      <% end %>
    </div>
    
    <div class="col-md-4">
      <div class="card">
        <div class="card-header">
          Categories
          <%= link_to "View All", blog_categories_path, class: "float-end btn btn-sm btn-outline-primary" %>
        </div>
        <div class="card-body">
          <ul class="list-unstyled">
            <% @categories.each do |cat| %>
              <li><%= link_to cat.name, blog_category_path(cat) %> (<%= cat.posts.count %>)</li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>