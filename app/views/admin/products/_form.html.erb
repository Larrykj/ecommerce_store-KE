<%= form_with(model: [:admin, product], local: true) do |form| %>
  <% if product.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= t('error_prohibited_save', count: product.errors.count, resource: t('product')) %>:</h4>
      <ul>
        <% product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, t('name'), class: 'form-label' %>
    <%= form.text_field :name, class: 'form-control', placeholder: t('enter_product_name') %>
  </div>

  <div class="mb-3">
    <%= form.label :description, t('description'), class: 'form-label' %>
    <%= form.text_area :description, class: 'form-control', rows: 5, placeholder: t('enter_product_description') %>
  </div>

  <div class="mb-3">
    <%= form.label :price, t('price'), class: 'form-label' %>
    <%= form.number_field :price, class: 'form-control', step: 0.01, placeholder: '0.00' %>
  </div>

  <div class="mb-3">
    <%= form.label :category_id, t('category'), class: 'form-label' %>
    <%= form.collection_select :category_id, Category.all, :id, :name, { prompt: "Select Category" }, class: 'form-control' %>
  </div>

  <div class="mb-3">
    <%= form.label :image, t('product_image'), class: 'form-label' %>
    <%= form.file_field :image, class: 'form-control', accept: 'image/png,image/jpg,image/jpeg,image/gif' %>
    
    <% if product.image.attached? %>
      <div class="mt-2">
        <p class="text-muted"><%= t('current_image') %></p>
        <%= image_tag product.image, width: 200, class: 'img-thumbnail' %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :gallery_images, "Gallery Images (Multiple)", class: 'form-label' %>
    <%= form.file_field :gallery_images, class: 'form-control', accept: 'image/png,image/jpg,image/jpeg,image/gif', multiple: true %>
    <small class="text-muted"><i class="bi bi-info-circle me-1"></i>You can select multiple images. These appear as thumbnails on the product page.</small>
    
    <% if product.gallery_images.attached? %>
      <div class="mt-2 d-flex gap-2 flex-wrap">
        <% product.gallery_images.each do |img| %>
          <%= image_tag img, width: 80, height: 80, class: 'img-thumbnail', style: 'object-fit: cover;' %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="card mb-4 border-info">
    <div class="card-header bg-info text-white">
      <h5 class="mb-0">Product Variants</h5>
    </div>
    <div class="card-body">
      <%= form.fields_for :variants do |variant_form| %>
        <div class="variant-fields border rounded p-3 mb-3 bg-light position-relative">
          <div class="row">
            <div class="col-md-3 mb-2">
              <%= variant_form.label :sku, "SKU", class: "form-label" %>
              <%= variant_form.text_field :sku, class: "form-control form-control-sm", placeholder: "e.g., TS-RED-M" %>
            </div>
            <div class="col-md-3 mb-2">
              <%= variant_form.label :name, "Variant Name", class: "form-label" %>
              <%= variant_form.text_field :name, class: "form-control form-control-sm", placeholder: "e.g., Medium / Red" %>
            </div>
            <div class="col-md-2 mb-2">
              <%= variant_form.label :price, "Variant Price (opt)", class: "form-label" %>
              <%= variant_form.number_field :price, step: 0.01, class: "form-control form-control-sm", placeholder: "Leaves blank to use base" %>
            </div>
            <div class="col-md-2 mb-2">
              <%= variant_form.label :quantity, "Stock Qty", class: "form-label" %>
              <%= variant_form.number_field :quantity, class: "form-control form-control-sm", placeholder: "0", min: 0 %>
            </div>
            <div class="col-md-12 mb-2">
              <%= variant_form.label :variant_image, "Variant Image", class: "form-label" %>
              <%= variant_form.file_field :variant_image, class: "form-control form-control-sm", accept: 'image/*' %>
              <% if variant_form.object.persisted? && variant_form.object.variant_image.attached? %>
                <%= image_tag variant_form.object.variant_image, width: 50, height: 50, class: 'img-thumbnail mt-1', style: 'object-fit: cover;' %>
              <% end %>
            </div>
            <% if variant_form.object.persisted? %>
              <div class="col-md-2 mb-2 d-flex align-items-end">
                <div class="form-check text-danger">
                  <%= variant_form.check_box :_destroy, class: "form-check-input" %>
                  <%= variant_form.label :_destroy, "Remove Variant", class: "form-check-label font-weight-bold" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
      <small class="text-muted"><i class="bi bi-info-circle me-1"></i>To add more variants later, use the Rails console or build out a dynamic JS "Add Variant" button.</small>
    </div>
  </div>

  <div class="actions">
    <%= form.submit t('save_product'), class: 'btn btn-success' %>
    <%= link_to t('cancel'), admin_products_path, class: 'btn btn-secondary' %>
  </div>
<% end %>
