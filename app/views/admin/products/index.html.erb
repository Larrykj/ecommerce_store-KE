<div class="admin-topbar">
  <h1><i class="bi bi-box-seam me-2"></i>Products</h1>
  <div class="topbar-actions">
    <%= form_with url: admin_products_path, method: :get, local: true, class: "d-flex gap-2" do %>
      <input type="text" name="search" value="<%= params[:search] %>" class="form-control" placeholder="Search products..." style="width: 250px;">
      <button type="submit" class="btn-admin btn-admin-primary"><i class="bi bi-search"></i></button>
    <% end %>
    <%= link_to new_admin_product_path, class: "btn-admin btn-admin-primary" do %>
      <i class="bi bi-plus-lg me-1"></i> New Product
    <% end %>
  </div>
</div>

<div class="admin-card">
  <div class="admin-card-body">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Product</th>
          <th>Category</th>
          <th>Price</th>
          <th>Stock</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td>
              <div class="d-flex align-items-center gap-3">
                <% if product.image.attached? %>
                  <%= image_tag product.image, style: "width:40px; height:40px; border-radius:8px; object-fit:cover;" %>
                <% else %>
                  <div style="width:40px; height:40px; border-radius:8px; background:#f1f5f9; display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-box-seam text-muted"></i>
                  </div>
                <% end %>
                <strong><%= product.name %></strong>
              </div>
            </td>
            <td><%= product.category&.name || "Uncategorized" %></td>
            <td><%= format_price(product.price) %></td>
            <td><span class="badge-status badge-<%= product.stock_status_class %>"><%= product.quantity %> units</span></td>
            <td>
              <% if product.discarded? %>
                <span class="badge-status badge-archived">Archived</span>
              <% else %>
                <span class="badge-status badge-active">Active</span>
              <% end %>
            </td>
            <td>
              <div class="d-flex gap-2">
                <%= link_to edit_admin_product_path(product), class: "btn btn-sm btn-outline-primary" do %>
                  <i class="bi bi-pencil"></i>
                <% end %>
                <% if product.discarded? %>
                  <%= button_to restore_admin_product_path(product), method: :patch, class: "btn btn-sm btn-outline-success", data: { turbo_confirm: "Restore this product?" } do %>
                    <i class="bi bi-arrow-counterclockwise"></i>
                  <% end %>
                <% else %>
                  <%= button_to admin_product_path(product), method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Archive this product?" } do %>
                    <i class="bi bi-archive"></i>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
