<div class="admin-topbar">
  <div>
    <h1><i class="bi bi-envelope-open me-2"></i>Message from <%= @message.name %></h1>
    <p class="text-muted mb-0"><%= @message.created_at.strftime("%B %d, %Y at %H:%M") %></p>
  </div>
  <div class="topbar-actions">
    <%= link_to admin_contact_messages_path, class: "btn-admin btn-admin-outline" do %>
      <i class="bi bi-arrow-left me-1"></i> Back
    <% end %>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="admin-card">
      <div class="admin-card-header">
        <h5><%= @message.subject %></h5>
      </div>
      <div class="admin-card-body">
        <p style="color: #475569; line-height: 1.8; white-space: pre-wrap; font-size: 1rem;"><%= @message.message %></p>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="admin-card">
      <div class="admin-card-header">
        <h5>Sender Details</h5>
      </div>
      <div class="admin-card-body">
        <p><strong>Name:</strong> <%= @message.name %></p>
        <p><strong>Email:</strong> <%= mail_to @message.email, @message.email, style: "color: #4f46e5;" %></p>
        <% if @message.user %>
          <p><strong>Registered User:</strong> Yes (<%= link_to "View", admin_user_path(@message.user), style: "color: #4f46e5;" %>)</p>
        <% else %>
          <p><strong>Registered User:</strong> No</p>
        <% end %>
        <p><strong>Received:</strong> <%= @message.created_at.strftime("%b %d, %Y %H:%M") %></p>
        <hr>
        <a href="mailto:<%= @message.email %>?subject=Re: <%= @message.subject %>" class="btn-admin btn-admin-primary w-100 text-center">
          <i class="bi bi-reply me-1"></i> Reply via Email
        </a>
      </div>
    </div>
  </div>
</div>
