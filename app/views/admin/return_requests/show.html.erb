<div class="admin-topbar">
  <div>
    <h1><i class="bi bi-arrow-return-left me-2"></i>Return Request #<%= @return_request.id %></h1>
    <p class="text-muted mb-0">Order #<%= @return_request.order_id %> — <%= @return_request.user&.name %></p>
  </div>
  <div class="topbar-actions">
    <%= link_to "← Back", admin_return_requests_path, class: "btn-admin btn-admin-outline" %>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="admin-card">
      <div class="admin-card-header"><h5>Request Details</h5></div>
      <div class="admin-card-body" style="padding: 24px;">
        <div class="row mb-3">
          <div class="col-md-4">
            <strong class="text-muted d-block">Reason</strong>
            <span><%= @return_request.reason %></span>
          </div>
          <div class="col-md-4">
            <strong class="text-muted d-block">Status</strong>
            <span class="badge-status badge-<%= @return_request.status == 'approved' ? 'completed' : @return_request.status %>"><%= @return_request.status.capitalize %></span>
          </div>
          <div class="col-md-4">
            <strong class="text-muted d-block">Submitted</strong>
            <span><%= @return_request.created_at.strftime("%B %d, %Y at %l:%M %p") %></span>
          </div>
        </div>
        <strong class="text-muted d-block">Customer Description</strong>
        <p class="mt-1"><%= @return_request.description %></p>

        <strong class="text-muted d-block mb-2">Order Items</strong>
        <table class="admin-table">
          <thead><tr><th>Product</th><th>SKU</th><th>Qty</th><th>Price</th></tr></thead>
          <tbody>
            <% @return_request.order.order_items.each do |item| %>
              <tr>
                <td><%= item.variant&.product&.name %></td>
                <td><%= item.variant&.sku %></td>
                <td><%= item.quantity %></td>
                <td><%= format_price(item.price * item.quantity) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="admin-card">
      <div class="admin-card-header"><h5>Update Status</h5></div>
      <div class="admin-card-body" style="padding: 24px;">
        <%= form_with(model: [:admin, @return_request], local: true) do |f| %>
          <div class="mb-3">
            <%= f.label :status, "Status", class: "form-label fw-bold" %>
            <%= f.select :status, [["Pending", "pending"], ["Approved", "approved"], ["Rejected", "rejected"], ["Completed", "completed"]], {}, class: "form-select" %>
          </div>
          <div class="mb-3">
            <%= f.label :admin_notes, "Admin Notes", class: "form-label fw-bold" %>
            <%= f.text_area :admin_notes, class: "form-control", rows: 4, placeholder: "Add notes for the customer..." %>
          </div>
          <%= f.submit "Update Request", class: "btn-admin btn-admin-primary w-100" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
