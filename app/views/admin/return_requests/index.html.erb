<div class="admin-topbar">
  <div>
    <h1><i class="bi bi-arrow-return-left me-2"></i>Return Requests</h1>
    <p class="text-muted mb-0">Manage customer return and refund requests</p>
  </div>
  <div class="topbar-actions">
    <% { "all" => "All", "pending" => "Pending", "approved" => "Approved", "rejected" => "Rejected" }.each do |status, label| %>
      <%= link_to label, admin_return_requests_path(status: status == "all" ? nil : status), class: "btn-admin #{params[:status] == status || (status == 'all' && params[:status].blank?) ? 'btn-admin-primary' : 'btn-admin-outline'}" %>
    <% end %>
  </div>
</div>

<div class="admin-card">
  <div class="admin-card-body">
    <table class="admin-table">
      <thead>
        <tr><th>ID</th><th>Order</th><th>Customer</th><th>Reason</th><th>Status</th><th>Date</th><th></th></tr>
      </thead>
      <tbody>
        <% @return_requests.each do |rr| %>
          <tr>
            <td>#<%= rr.id %></td>
            <td><%= link_to "##{rr.order_id}", admin_order_path(rr.order), style: "color: #4f46e5; font-weight: 600;" %></td>
            <td><%= rr.user&.name %></td>
            <td><%= rr.reason.truncate(30) %></td>
            <td>
              <% colors = { "pending" => "badge-pending", "approved" => "badge-completed", "rejected" => "badge-cancelled", "completed" => "badge-shipped" } %>
              <span class="badge-status <%= colors[rr.status] %>"><%= rr.status.capitalize %></span>
            </td>
            <td class="text-muted"><%= rr.created_at.strftime("%b %d") %></td>
            <td><%= link_to "Review", admin_return_request_path(rr), class: "btn-admin btn-admin-primary btn-sm" %></td>
          </tr>
        <% end %>
        <% if @return_requests.empty? %>
          <tr><td colspan="7" class="text-center text-muted py-4">No return requests</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
