<div class="admin-topbar">
  <div>
    <h1><%= @shipping_method.new_record? ? "New Shipping Method" : "Edit Shipping Method" %></h1>
  </div>
  <div class="topbar-actions">
    <%= link_to admin_shipping_methods_path, class: "btn-admin btn-admin-outline" do %>
      <i class="bi bi-arrow-left me-1"></i> Back
    <% end %>
  </div>
</div>

<div class="admin-card" style="max-width: 600px;">
  <div class="admin-card-body">
    <%= form_with model: [:admin, @shipping_method], local: true do |f| %>
      <% if @shipping_method.errors.any? %>
        <div class="alert alert-danger admin-alert admin-alert-danger" style="border-radius: 12px;">
          <ul class="mb-0">
            <% @shipping_method.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :name, class: "form-label fw-bold" %>
        <%= f.text_field :name, class: "form-control #{'is-invalid' if @shipping_method.errors[:name].any?}", placeholder: "e.g. Standard Delivery" %>
        <% @shipping_method.errors[:name].each do |error| %>
          <div class="invalid-feedback d-block"><%= error %></div>
        <% end %>
      </div>

      <div class="mb-3">
        <%= f.label :base_rate, "Base Rate (KES)", class: "form-label fw-bold" %>
        <%= f.number_field :base_rate, class: "form-control #{'is-invalid' if @shipping_method.errors[:base_rate].any?}", step: 0.01, min: 0 %>
        <% @shipping_method.errors[:base_rate].each do |error| %>
          <div class="invalid-feedback d-block"><%= error %></div>
        <% end %>
      </div>

      <div class="mb-3">
        <%= f.label :estimated_days, "Estimated Delivery Days", class: "form-label fw-bold" %>
        <%= f.number_field :estimated_days, class: "form-control #{'is-invalid' if @shipping_method.errors[:estimated_days].any?}", min: 1 %>
        <% @shipping_method.errors[:estimated_days].each do |error| %>
          <div class="invalid-feedback d-block"><%= error %></div>
        <% end %>
      </div>

      <div class="mb-4">
        <div class="form-check">
          <%= f.check_box :active, class: "form-check-input" %>
          <%= f.label :active, "Active", class: "form-check-label" %>
        </div>
      </div>

      <%= f.submit @shipping_method.new_record? ? "Create Shipping Method" : "Update Shipping Method", class: "btn-admin btn-admin-primary w-100", data: { disable_with: "Saving..." } %>
    <% end %>
  </div>
</div>
