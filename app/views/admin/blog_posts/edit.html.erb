<h1>Edit Blog Post</h1>

<%= form_with model: @post, url: admin_blog_post_path(@post), method: :patch, local: true, class: 'needs-validation' do |f| %>
  <% if @post.errors.any? %>
    <div class="alert alert-danger mb-3">
      <h4><%= pluralize(@post.errors.count, "error") %> prohibited this post:</h4>
      <ul>
        <% @post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card mb-4">
    <div class="card-header">Post Content</div>
    <div class="card-body">
      <div class="mb-3">
        <%= f.label :title, class: 'form-label' %>
        <%= f.text_field :title, class: 'form-control', required: true %>
      </div>

      <div class="mb-3">
        <%= f.label :content, class: 'form-label' %>
        <%= f.text_area :content, class: 'form-control', rows: 10, required: true %>
      </div>

      <div class="mb-3">
        <%= f.label :excerpt, class: 'form-label' %>
        <%= f.text_area :excerpt, class: 'form-control', rows: 3, placeholder: 'Optional - leave blank to auto-generate from content' %>
      </div>

      <div class="mb-3">
        <%= f.label :featured_image, class: 'form-label' %>
        <%= f.text_field :featured_image, class: 'form-control', placeholder: 'Image path or URL' %>
      </div>

      <div class="mb-3">
        <%= f.label :category_id, class: 'form-label' %>
        <%= f.collection_select :category_id, BlogCategory.all, :id, :name, { include_blank: 'No Category' }, class: 'form-control' %>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header">Publishing</div>
    <div class="card-body">
      <div class="mb-3">
        <%= f.label :published_at, class: 'form-label' %>
        <%= f.datetime_select :published_at, class: 'form-control' %>
      </div>

      <div class="mb-3">
        <%= f.check_box :published %>
        <%= f.label :published, 'Published' %>
      </div>
    </div>
  </div>

  <div class="d-grid gap-2 d-sm-flex justify-content-sm-start">
    <%= f.submit 'Update Post', class: 'btn btn-primary' %>
    <%= link_to 'Cancel', admin_blog_posts_path, class: 'btn btn-secondary' %>
    <%= link_to 'Delete', admin_blog_post_path(@post), method: :delete, data: { confirm: 'Delete this post?' }, class: 'btn btn-danger' %>
  </div>
<% end %>
