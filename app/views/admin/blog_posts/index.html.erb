<h1>Blog Posts</h1>
<%= link_to 'New Post', new_admin_blog_post_path, class: 'btn btn-primary mb-3' %>
<table class="table">
  <thead>
    <tr>
      <th>Title</th>
      <th>Category</th>
      <th>Status</th>
      <th>Views</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @posts.each do |post| %>
      <tr>
        <td><%= post.title %></td>
        <td><%= post.category&.name %></td>
        <td><%= post.published ? 'Published' : 'Draft' %></td>
        <td><%= post.views_count %></td>
        <td>
          <%= link_to 'Edit', edit_admin_blog_post_path(post), class: 'btn btn-sm btn-secondary' %>
          <%= link_to 'Delete', admin_blog_post_path(post), method: :delete, data: { confirm: 'Delete?' }, class: 'btn btn-sm btn-danger' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<% if @pagy.pages > 1 %>
  <div class="mt-3">
    <%== @pagy.series_nav(:bootstrap) %>
  </div>
<% end %>