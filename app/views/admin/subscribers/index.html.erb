<div class="admin-topbar">
  <div>
    <h1><i class="bi bi-envelope-paper me-2"></i>Newsletter Subscribers</h1>
    <p class="text-muted mb-0"><%= @active_count %> active / <%= @total_count %> total subscribers</p>
  </div>
</div>

<div class="admin-card">
  <div class="admin-card-body">
    <table class="admin-table">
      <thead>
        <tr><th>Email</th><th>Name</th><th>Status</th><th>Subscribed</th><th></th></tr>
      </thead>
      <tbody>
        <% @subscribers.each do |sub| %>
          <tr>
            <td><strong><%= sub.email %></strong></td>
            <td><%= sub.name || "—" %></td>
            <td><span class="badge-status badge-<%= sub.active? ? 'active' : 'cancelled' %>"><%= sub.status.capitalize %></span></td>
            <td class="text-muted"><%= sub.created_at.strftime("%b %d, %Y") %></td>
            <td><%= button_to "Remove", admin_subscriber_path(sub), method: :delete, class: "btn-admin btn-admin-outline btn-sm", data: { turbo_confirm: "Remove this subscriber?" } %></td>
          </tr>
        <% end %>
        <% if @subscribers.empty? %>
          <tr><td colspan="5" class="text-center text-muted py-4">No subscribers yet</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
