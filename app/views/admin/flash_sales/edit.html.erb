<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3">Edit Flash Sale</h1>
  <div>
    <%= link_to 'Back to Sales', admin_flash_sales_path, class: 'btn btn-outline-secondary me-2' %>
  </div>
</div>

<div class="card shadow-sm border-0 mb-5">
  <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
    <h5 class="mb-0 text-primary"><i class="bi bi-lightning-charge"></i> Flash Sale Details</h5>
    <% if @flash_sale.active? %>
      <span class="badge bg-success bg-opacity-10 text-success border border-success">Currently Live</span>
    <% elsif @flash_sale.active && @flash_sale.start_time > Time.current %>
      <span class="badge bg-info bg-opacity-10 text-info border border-info">Scheduled</span>
    <% else %>
      <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary">Inactive / Ended</span>
    <% end %>
  </div>
  <div class="card-body p-4">
    <%= form_with model: @flash_sale, url: admin_flash_sale_path(@flash_sale), method: :patch, local: true, class: 'needs-validation' do |f| %>
      <% if @flash_sale.errors.any? %>
        <div class="alert alert-danger rounded-3 mb-4">
          <h6 class="alert-heading fw-bold"><i class="bi bi-exclamation-triangle"></i> Please fix the following <%= pluralize(@flash_sale.errors.count, "error") %>:</h6>
          <ul class="mb-0">
            <% @flash_sale.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="row g-4">
        <div class="col-md-12">
          <%= f.label :name, class: 'form-label fw-bold text-muted small' %>
          <%= f.text_field :name, class: 'form-control form-control-lg', required: true %>
        </div>

        <div class="col-md-6">
          <div class="form-group">
            <%= f.label :start_time, class: 'form-label fw-bold text-muted small' %>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar-check text-muted"></i></span>
              <%= f.datetime_field :start_time, class: 'form-control border-start-0', required: true %>
            </div>
            <div class="form-text">When will the flash sale begin?</div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="form-group">
            <%= f.label :end_time, class: 'form-label fw-bold text-muted small' %>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar-x text-muted"></i></span>
              <%= f.datetime_field :end_time, class: 'form-control border-start-0', required: true %>
            </div>
            <div class="form-text">When will the flash sale automatically end?</div>
          </div>
        </div>

        <div class="col-12 mt-4 pt-3 border-top">
          <div class="form-check form-switch form-switch-lg">
            <%= f.check_box :active, class: 'form-check-input', role: 'switch' %>
            <%= f.label :active, 'Enable Flash Sale', class: 'form-check-label fw-bold ms-2' %>
            <div class="form-text ms-2 mt-1">If enabled, the sale will automatically start and end at the specified times.</div>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-between align-items-center mt-5">
        <%= link_to 'Danger: Delete Sale', admin_flash_sale_path(@flash_sale), method: :delete, data: { confirm: 'Are you absolutely sure you want to delete this flash sale? This action cannot be undone.' }, class: 'text-danger small fw-bold text-decoration-none' %>
        
        <div class="d-flex gap-3">
          <%= link_to 'Cancel', admin_flash_sales_path, class: 'btn btn-light px-4 py-2' %>
          <%= f.submit 'Update Flash Sale', class: 'btn btn-primary px-4 py-2 shadow-sm' %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="card shadow-sm border-0 mb-5">
  <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
    <h5 class="mb-0 text-primary"><i class="bi bi-box-seam"></i> Products in this Flash Sale</h5>
  </div>
  <div class="card-body p-4">
    <% if @flash_sale.flash_sale_products.any? %>
      <div class="table-responsive mb-4">
        <table class="table align-middle">
          <thead class="bg-light text-muted">
            <tr>
              <th class="ps-3 border-0 py-3">Product Name</th>
              <th class="border-0 py-3 text-center">Special Flash Price</th>
              <th class="pe-3 border-0 py-3 text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% @flash_sale.flash_sale_products.each do |fsp| %>
              <tr>
                <td class="ps-3 fw-bold"><%= fsp.product.name %></td>
                <td class="text-center font-monospace text-success fw-bold">
                  <% if fsp.special_price %>
                    KSh <%= number_with_precision(fsp.special_price, precision: 2) %>
                  <% else %>
                    N/A
                  <% end %>
                </td>
                <td class="pe-3 text-end">
                  <%= link_to remove_product_admin_flash_sale_path(@flash_sale, product_id: fsp.product_id), method: :delete, data: { confirm: 'Remove product from flash sale?' }, class: 'btn btn-sm btn-outline-danger' do %>
                    <i class="bi bi-x-circle"></i> Remove
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="alert alert-light text-center text-muted mb-4 border border-dashed p-5">
        <i class="bi bi-boxes display-4 text-muted mb-3 d-block alpha-50"></i>
        <h6 class="fw-bold">No products attached</h6>
        <p class="mb-0 small">Add products to this flash sale using the form below.</p>
      </div>
    <% end %>

    <div class="bg-light p-4 rounded-3 border">
      <h6 class="fw-bold mb-3"><i class="bi bi-plus-circle-dotted me-2"></i>Link New Product to Sale</h6>
      <%= form_with url: add_product_admin_flash_sale_path(@flash_sale), method: :post, local: true, class: 'row g-3 align-items-end' do |f| %>
        <div class="col-md-6">
          <%= f.label :product_id, 'Select Product', class: 'form-label fw-bold small text-muted' %>
          <%= f.collection_select :product_id, Product.all.order(:name), :id, :name, { prompt: 'Browse catalog...' }, { class: 'form-select', required: true } %>
        </div>
        <div class="col-md-4">
          <%= f.label :special_price, 'Flash Sale Deal Price (KSh)', class: 'form-label fw-bold small text-muted' %>
          <div class="input-group">
            <span class="input-group-text">KSh</span>
            <%= f.number_field :special_price, step: 0.01, class: 'form-control', placeholder: 'E.g., 4999.99' %>
          </div>
        </div>
        <div class="col-md-2 d-grid">
          <%= f.submit 'Add Product', class: 'btn btn-primary shadow-sm' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
