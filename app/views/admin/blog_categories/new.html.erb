<div class="mb-4">
  <h1>Add Blog Category</h1>
</div>

<div class="card">
  <div class="card-body">
    <%= form_with model: [:admin, @category], local: true do |f| %>
      <% if @category.errors.any? %>
        <div class="alert alert-danger" role="alert">
          <h4 class="alert-heading"><%= pluralize(@category.errors.count, "error") %> prohibited this category from being saved:</h4>
          <ul>
            <% @category.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :name, "Category Name", class: "form-label" %>
        <%= f.text_field :name, class: "form-control", required: true %>
      </div>

      <div class="mb-3">
        <%= f.label :description, class: "form-label" %>
        <%= f.text_area :description, class: "form-control", rows: 3, placeholder: "Brief description of this category" %>
      </div>

      <div class="mb-3">
        <%= f.label :position, "Display Order", class: "form-label" %>
        <%= f.number_field :position, class: "form-control", placeholder: "Lower numbers appear first" %>
      </div>

      <div class="form-group">
        <%= f.submit "Create Category", class: "btn btn-primary" %>
        <%= link_to "Cancel", admin_blog_categories_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>
