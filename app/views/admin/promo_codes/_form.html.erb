<%= form_with model: [:admin, @promo_code], local: true do |form| %>
  <% if @promo_code.errors.any? %>
    <div class="alert alert-danger admin-alert admin-alert-danger">
      <h5 class="h6 mb-2"><%= pluralize(@promo_code.errors.count, "error") %> prohibited this promo code from being saved:</h5>
      <ul>
        <% @promo_code.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-3">
    <div class="col-md-6">
      <%= form.label :code, class: "form-label fw-bold" %>
      <%= form.text_field :code, class: "form-control #{'is-invalid' if @promo_code.errors[:code].any?}", style: "text-transform: uppercase;", required: true %>
      <% @promo_code.errors[:code].each do |error| %>
        <div class="invalid-feedback d-block"><%= error %></div>
      <% end %>
      <small class="text-muted">e.g. SUMMER2026</small>
    </div>
    <div class="col-md-6">
      <%= form.label :description, class: "form-label fw-bold" %>
      <%= form.text_field :description, class: "form-control" %>
    </div>

    <div class="col-md-4">
      <%= form.label :discount_type, class: "form-label fw-bold" %>
      <%= form.select :discount_type, [["Percentage (%)", "percentage"], ["Flat Amount", "flat"]], {}, class: "form-select" %>
    </div>
    <div class="col-md-4">
      <%= form.label :discount_value, class: "form-label fw-bold" %>
      <%= form.number_field :discount_value, step: "0.01", class: "form-control #{'is-invalid' if @promo_code.errors[:discount_value].any?}", required: true %>
      <% @promo_code.errors[:discount_value].each do |error| %>
        <div class="invalid-feedback d-block"><%= error %></div>
      <% end %>
    </div>
    <div class="col-md-4">
      <%= form.label :min_order_amount, "Min Order Amount (Optional)", class: "form-label fw-bold" %>
      <%= form.number_field :min_order_amount, step: "0.01", class: "form-control" %>
    </div>

    <div class="col-md-6">
      <%= form.label :max_uses, "Max Uses (Optional)", class: "form-label fw-bold" %>
      <%= form.number_field :max_uses, class: "form-control" %>
    </div>
    <div class="col-md-6">
      <%= form.label :expires_at, "Expiration Date (Optional)", class: "form-label fw-bold" %>
      <%= form.datetime_field :expires_at, class: "form-control" %>
    </div>

    <div class="col-12 mt-3 pt-3 border-top">
      <h6 class="fw-bold mb-3"><i class="bi bi-megaphone me-2 text-primary"></i>Storefront Announcement</h6>
    </div>
    
    <div class="col-md-12">
      <%= form.label :promo_message, "Announcement Message (Displayed to Customers)", class: "form-label fw-bold" %>
      <%= form.text_field :promo_message, class: "form-control", placeholder: "e.g. Use code SUMMER2026 for 5% off your next order!" %>
    </div>

    <div class="col-12">
      <div class="form-check form-switch mt-2">
        <%= form.check_box :display_on_storefront, class: "form-check-input", id: "displaySwitch" %>
        <%= form.label :display_on_storefront, "Display Banner on Storefront", class: "form-check-label fw-bold", for: "displaySwitch" %>
      </div>
    </div>

    <div class="col-12 mt-3 pt-3 border-top">
      <div class="form-check form-switch mt-2">
        <%= form.check_box :active, class: "form-check-input", id: "activeSwitch" %>
        <%= form.label :active, "Active", class: "form-check-label fw-bold", for: "activeSwitch" %>
      </div>
    </div>
  </div>

  <div class="mt-4 pt-3 border-top d-flex gap-2">
    <%= form.submit class: "btn btn-primary", data: { disable_with: "Saving..." } %>
    <%= link_to "Cancel", admin_promo_codes_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
