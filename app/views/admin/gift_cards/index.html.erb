<div class="admin-topbar">
  <div>
    <h1><i class="bi bi-gift me-2"></i>Gift Cards</h1>
    <p class="text-muted mb-0">Manage gift cards</p>
  </div>
  <div class="topbar-actions">
    <%= link_to admin_gift_cards_path(status: nil), class: "btn-admin #{params[:status].blank? ? 'btn-admin-primary' : 'btn-admin-outline'}" do %>All<% end %>
    <%= link_to admin_gift_cards_path(status: "active"), class: "btn-admin #{params[:status] == 'active' ? 'btn-admin-primary' : 'btn-admin-outline'}" do %>Active<% end %>
    <%= link_to new_admin_gift_card_path, class: "btn-admin btn-admin-primary" do %>
      <i class="bi bi-plus-lg me-1"></i>Create
    <% end %>
  </div>
</div>

<div class="admin-card">
  <div class="admin-card-body">
    <table class="admin-table">
      <thead>
        <tr><th>Code</th><th>Initial Value</th><th>Balance</th><th>Status</th><th>Recipient</th><th>Expires</th><th></th></tr>
      </thead>
      <tbody>
        <% @gift_cards.each do |gc| %>
          <tr>
            <td><code style="font-weight: 700; color: #4f46e5;"><%= gc.code %></code></td>
            <td>KSh <%= gc.initial_value.to_i %></td>
            <td><strong>KSh <%= gc.balance.to_i %></strong></td>
            <td><span class="badge-status badge-<%= gc.active? ? 'active' : 'cancelled' %>"><%= gc.status.capitalize %></span></td>
            <td><%= gc.recipient_email || "—" %></td>
            <td><%= gc.expires_at&.strftime("%b %d, %Y") || "Never" %></td>
            <td>
              <% if gc.status == "active" %>
                <%= button_to "Disable", admin_gift_card_path(gc), method: :delete, class: "btn-admin btn-admin-outline btn-sm", data: { turbo_confirm: "Disable this gift card?" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
        <% if @gift_cards.empty? %>
          <tr><td colspan="7" class="text-center text-muted py-4">No gift cards</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
