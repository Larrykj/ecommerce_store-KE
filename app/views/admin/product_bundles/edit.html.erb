<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3">Edit Product Bundle</h1>
  <div>
    <%= link_to 'Back to Bundles', admin_product_bundles_path, class: 'btn btn-outline-secondary me-2' %>
  </div>
</div>

<div class="card shadow-sm border-0 mb-5">
  <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
    <h5 class="mb-0 text-primary"><i class="bi bi-collection-play"></i> Bundle Details</h5>
    <% if @bundle.active? %>
      <span class="badge bg-success bg-opacity-10 text-success border border-success">Active Showcase</span>
    <% else %>
      <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary">Hidden from Store</span>
    <% end %>
  </div>
  <div class="card-body p-4">
    <%= form_with model: @bundle, url: admin_product_bundle_path(@bundle), method: :patch, local: true, class: 'needs-validation' do |f| %>
      <% if @bundle.errors.any? %>
        <div class="alert alert-danger rounded-3 mb-4">
          <h6 class="alert-heading fw-bold"><i class="bi bi-exclamation-triangle"></i> Please fix the following <%= pluralize(@bundle.errors.count, "error") %>:</h6>
          <ul class="mb-0">
            <% @bundle.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="row g-4">
        <div class="col-md-12">
          <%= f.label :name, class: 'form-label fw-bold text-muted small' %>
          <%= f.text_field :name, class: 'form-control form-control-lg', required: true %>
        </div>

        <div class="col-md-12">
          <%= f.label :description, class: 'form-label fw-bold text-muted small' %>
          <%= f.text_area :description, class: 'form-control', rows: 3 %>
        </div>

        <div class="col-md-6">
          <div class="form-group">
            <%= f.label :price, 'Bundle Selling Price (KSh)', class: 'form-label fw-bold text-muted small' %>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0 text-muted">KSh</span>
              <%= f.number_field :price, step: 0.01, class: 'form-control border-start-0', required: true %>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="form-group">
            <%= f.label :original_price, 'Original Unbundled Value (KSh)', class: 'form-label fw-bold text-muted small' %>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0 text-muted">KSh</span>
              <%= f.number_field :original_price, step: 0.01, class: 'form-control border-start-0', placeholder: 'Used to calculate total savings' %>
            </div>
          </div>
        </div>

        <div class="col-12 mt-4 pt-3 border-top">
          <div class="form-check form-switch form-switch-lg">
            <%= f.check_box :active, class: 'form-check-input', role: 'switch' %>
            <%= f.label :active, 'Enable Bundle Listing', class: 'form-check-label fw-bold ms-2' %>
            <div class="form-text ms-2 mt-1">If enabled, this bundle will be visible and purchasable.</div>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-between align-items-center mt-5">
        <%= link_to 'Danger: Delete Bundle', admin_product_bundle_path(@bundle), method: :delete, data: { confirm: 'Are you absolutely sure you want to delete this bundle?' }, class: 'text-danger small fw-bold text-decoration-none' %>
        
        <div class="d-flex gap-3">
          <%= form_with model: @bundle, url: admin_product_bundle_path(@bundle), method: :patch, local: true do |empty_f| %>
            <%= empty_f.submit 'Revert', type: 'reset', class: 'btn btn-light px-4 py-2 d-none' %>
          <% end %>
          <%= link_to 'Cancel', admin_product_bundles_path, class: 'btn btn-light px-4 py-2' %>
          <%= f.submit 'Update Bundle Details', class: 'btn btn-primary px-4 py-2 shadow-sm' %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="card shadow-sm border-0 mb-5">
  <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
    <h5 class="mb-0 text-primary"><i class="bi bi-boxes"></i> Bundle Components</h5>
  </div>
  <div class="card-body p-4">
    <% if @bundle.items.any? %>
      <div class="table-responsive mb-4">
        <table class="table align-middle">
          <thead class="bg-light text-muted">
            <tr>
              <th class="ps-3 border-0 py-3">Product Name</th>
              <th class="border-0 py-3 text-center">Unit Price</th>
              <th class="border-0 py-3 text-center">Quantity</th>
              <th class="pe-3 border-0 py-3 text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% @bundle.items.includes(:product).each do |item| %>
              <tr>
                <td class="ps-3 fw-bold"><%= item.product.name %></td>
                <td class="text-center font-monospace text-muted">KSh <%= number_with_precision(item.product.price, precision: 2) %></td>
                <td class="text-center fw-bold"><%= item.quantity || 1 %>x</td>
                <td class="pe-3 text-end">
                  <%= link_to remove_product_admin_product_bundle_path(@bundle, product_id: item.product_id), method: :delete, data: { confirm: 'Remove product from bundle?' }, class: 'btn btn-sm btn-outline-danger' do %>
                    <i class="bi bi-x-circle"></i> Remove
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="alert alert-light text-center text-muted mb-4 border border-dashed p-5">
        <i class="bi bi-box-seam display-4 text-muted mb-3 d-block alpha-50"></i>
        <h6 class="fw-bold">No components added</h6>
        <p class="mb-0 small">Add child products to this bundle wrapper below.</p>
      </div>
    <% end %>

    <div class="bg-light p-4 rounded-3 border">
      <h6 class="fw-bold mb-3"><i class="bi bi-plus-circle-dotted me-2"></i>Append Item to Bundle</h6>
      <%= form_with url: add_product_admin_product_bundle_path(@bundle), method: :post, local: true, class: 'row g-3 align-items-end' do |f| %>
        <div class="col-md-7">
          <%= f.label :product_id, 'Select Product', class: 'form-label fw-bold small text-muted' %>
          <%= f.collection_select :product_id, Product.all.order(:name), :id, :name, { prompt: 'Browse catalog...' }, { class: 'form-select', required: true } %>
        </div>
        <div class="col-md-3">
          <%= f.label :quantity, 'Qty', class: 'form-label fw-bold small text-muted' %>
          <%= f.number_field :quantity, value: 1, min: 1, class: 'form-control', required: true %>
        </div>
        <div class="col-md-2 d-grid">
          <%= f.submit 'Add Item', class: 'btn btn-primary shadow-sm' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
