# Environment Variables for E-Commerce Rails
# Copy this file to .env and fill in your actual values
# .env is in .gitignore — never commit real secrets to git

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost/ecommerce_production

# Encryption Keys (Generate new ones for production!)
# Generate with: bundle exec rails db:encryption:init
ACTIVE_RECORD_PRIMARY_KEY=your_primary_key_here
ACTIVE_RECORD_DETERMINISTIC_KEY=your_deterministic_key_here
ACTIVE_RECORD_KEY_DERIVATION_SALT=your_salt_here

# Lockbox Encryption (Generate new one for production!)
# Generate with: bundle exec rails runner "puts Lockbox.generate_key"
LOCKBOX_MASTER_KEY=your_lockbox_master_key_here

# Rails Secret Key Base
SECRET_KEY_BASE=your_secret_key_base_here

# Stripe Payment Processing
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
# Get from: https://dashboard.stripe.com/webhooks (after creating a webhook endpoint)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Currency for Stripe payments (default: usd). Set to kes once account supports it.
STRIPE_CURRENCY=usd

# OpenAI API Key (for AI chat and recommendation features)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Social Auth Credentials (OAuth)
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Optional: Email Configuration (if using SMTP)
# SMTP_USER_NAME=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
